# Password for /list (contacts) and /admin (events)
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie
SESSION_SECRET=change-me-too
# Port the site listens on
PORT=4321
# How often the server re-syncs events from Partiful, in minutes (0 turns it off)
SYNC_INTERVAL_MINUTES=60
# Instagram handle people can message from the public page (blank = no contact link there)
HOST_INSTAGRAM=
