# The diary, kept running by systemd.
#
#   sudo cp deploy/dz-diary.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dz-diary
#
# Logs: journalctl -u dz-diary -f

[Unit]
Description=dz-diary — diary (port 3030)
After=network-online.target
Wants=network-online.target dz-todo.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/workspace/diary
ExecStart=/home/ubuntu/.bun/bin/bun run /workspace/diary/server.js

Restart=always
RestartSec=2

KillSignal=SIGINT
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
# Reads and writes data/diary.db; talks to the to-do app on port 1242.
ReadWritePaths=/workspace

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dz-diary

[Install]
WantedBy=multi-user.target
