# The personal / investing site, kept running by systemd.
#
#   sudo cp deploy/dz-site.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dz-site
#
# Logs: journalctl -u dz-site -f

[Unit]
Description=dz-site — Dan Zhu personal site (port 3001)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/workspace/site
ExecStart=/home/ubuntu/.bun/bin/bun run /workspace/site/server.js

Restart=always
RestartSec=2

KillSignal=SIGINT
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
# pitches.db and its WAL live in /workspace/data.
ReadWritePaths=/workspace

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dz-site

[Install]
WantedBy=multi-user.target
